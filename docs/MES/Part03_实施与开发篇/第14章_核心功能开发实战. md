## 14.1 报工接口设计与实现
### 14.1.1 报工API设计
```java
// Spring Boot报工接口
@RestController
@RequestMapping("/api/mes/report")
public class WorkReportController {

    @Autowired
    private WorkReportService workReportService;

    @PostMapping("/work")
    public Result<ReportResponse> reportWork(@RequestBody ReportRequest request) {
        // 1. 参数校验
        ValidationResult validation = validateRequest(request);
        if (!validation.isValid()) {
            return Result.fail(validation.getErrorMsg());
        }

        // 2. 业务处理
        ReportResponse response = workReportService.processReport(request);

        return Result.success(response);
    }

    @PostMapping("/batch")
    public Result<List<ReportResponse>> batchReport(@RequestBody List<ReportRequest> requests) {
        List<ReportResponse> responses = new ArrayList<>();
        for (ReportRequest request : requests) {
            responses.add(workReportService.processReport(request));
        }
        return Result.success(responses);
    }
}
```
### 14.1.2 参数校验逻辑
```java
@Component
public class ReportValidator {

    public ValidationResult validate(ReportRequest request) {
        List<String> errors = new ArrayList<>();

        // 必填校验
        if (StringUtils.isEmpty(request.getWorkOrderId())) {
            errors.add("工单号不能为空");
        }
        if (StringUtils.isEmpty(request.getOperationId())) {
            errors.add("工序号不能为空");
        }

        // 数量校验
        if (request.getInputQty() == null || request.getInputQty() <= 0) {
            errors.add("投入数量必须大于0");
        }
        if (request.getOutputQty() > request.getInputQty()) {
            errors.add("产出数量不能大于投入数量");
        }

        return new ValidationResult(errors.isEmpty(), errors);
    }
}
```
### 14.1.3 事务处理
```java
@Service
@Transactional(rollbackFor = Exception.class)
public class WorkReportService {

    @Autowired
    private WorkOrderRepository workOrderRepository;

    @Autowired
    private MaterialInventoryService inventoryService;

    public ReportResponse processReport(ReportRequest request) {
        // 1. 锁定工单
        WorkOrder wo = workOrderRepository.lockById(request.getWorkOrderId());

        // 2. 更新工序状态
        OperationRecord record = new OperationRecord();
        record.setWorkOrderId(request.getWorkOrderId());
        record.setOperationId(request.getOperationId());
        record.setInputQty(request.getInputQty());
        record.setOutputQty(request.getOutputQty());
        record.setQualifiedQty(request.getQualifiedQty());
        record.setDefectQty(request.getInputQty() - request.getOutputQty());

        // 3. 物料消耗
        inventoryService.consumeMaterial(wo.getProductId(),
            request.getInputQty());

        // 4. 更新工单进度
        wo.setCompletedQty(wo.getCompletedQty() + request.getOutputQty());

        return buildResponse(record);
    }
}
```
## 14.2 排程引擎集成
### 14.2.1 排程服务封装
```python
# Python排程服务
from flask import Flask, request, jsonify
from scheduler.ga_scheduler import GeneticScheduler

app = Flask(__name__)

class SchedulingService:
    def __init__(self):
        self.scheduler = None

    def initialize(self, jobs_data, machines):
        self.scheduler = GeneticScheduler(jobs_data, machines)

    def schedule(self, order_id):
        if not self.scheduler:
            return None, "Scheduler not initialized"

        best_solution, makespan = self.scheduler.evolve()
        return {
            'order_id': order_id,
            'schedule': best_solution,
            'makespan': makespan
        }, None

scheduling_service = SchedulingService()

@app.route('/api/schedule', methods=['POST'])
def create_schedule():
    data = request.json
    order_id = data['order_id']
    jobs = data['jobs']
    machines = data['machines']

    scheduling_service.initialize(jobs, machines)
    result, error = scheduling_service.schedule(order_id)

    if error:
        return jsonify({'error': error}), 500
    return jsonify(result)
```
### 14.2.2 异步调用处理
```python
# 异步排程调用
import asyncio
from concurrent.futures import ThreadPoolExecutor
from queue import Queue

class AsyncScheduler:
    def __init__(self):
        self.executor = ThreadPoolExecutor(max_workers=4)
        self.result_queue = Queue()

    def submit(self, order_id, jobs, machines):
        future = self.executor.submit(self._run_scheduler, order_id, jobs, machines)
        return future

    def _run_scheduler(self, order_id, jobs, machines):
        service = SchedulingService()
        service.initialize(jobs, machines)
        result, error = service.schedule(order_id)
        return {'order_id': order_id, 'result': result, 'error': error}
