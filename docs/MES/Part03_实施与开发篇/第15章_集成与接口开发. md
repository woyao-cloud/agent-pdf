### 15.4.3 接口限流

```python
# 接口限流实现
from flask_limiter import Limiter
from flask_limiter.util import get_remote_address

limiter = Limiter(
    key_func=get_remote_address,
    app=app,
    default_limits=["200 per day", "50 per hour"]
)

class RateLimitConfig:
    # 不同接口的限流规则
    WORKORDER_LIST = "10 per second"
    WORKORDER_CREATE = "5 per second"
    REPORT_WORK = "20 per second"
    QUERY_EQUIPMENT = "30 per second"

@app.route('/api/mes/v1/workorders', methods=['GET'])
@limiter.limit(RateLimitConfig.WORKORDER_LIST)
def get_workorders():
    return jsonify([])

@app.route('/api/mes/v1/workorders', methods=['POST'])
@limiter.limit(RateLimitConfig.WORKORDER_CREATE)
def create_workorder():
    return jsonify({}), 201

# 分布式限流（使用Redis）
