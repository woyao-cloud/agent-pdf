### 15.1.3 接口版本管理

接口版本管理确保系统升级的兼容性：

```python
# URL版本控制
@app.route('/api/mes/v1/workorders')
def workorders_v1():
    return jsonify({'version': 'v1', 'data': []})

@app.route('/api/mes/v2/workorders')
def workorders_v2():
    return jsonify({'version': 'v2', 'data': []})

# Header版本控制
@app.route('/api/mes/workorders')
def workorders():
    version = request.headers.get('X-API-Version', 'v1')

    if version == 'v1':
        return jsonify_v1()
    elif version == 'v2':
        return jsonify_v2()
    else:
        return jsonify({'error': 'Unsupported version'}), 400
```

## 15.2 中间件技术

### 15.2.1 Kafka应用场景

Kafka是大数据场景和事件流处理的首选，在MES中用于：

- **生产事件流**：报工、订单状态变更、设备事件
- **日志收集**：系统日志、应用日志收集
- **实时分析**：连接Flink进行实时数据处理

```python
# MES Kafka配置与生产者
from kafka import KafkaProducer, KafkaConsumer
from kafka.admin import KafkaAdminClient, NewTopic
import json

class MesKafkaProducer:
    def __init__(self, bootstrap_servers=['localhost:9092']):
        self.producer = KafkaProducer(
            bootstrap_servers=bootstrap_servers,
            value_serializer=lambda v: json.dumps(v).encode('utf-8'),
            key_serializer=lambda k: k.encode('utf-8') if k else None,
            acks='all',  # 确保所有副本确认
            retries=3,
            max_in_flight_requests_per_connection=1
        )

    def send_work_report(self, report_data):
        """发送报工事件"""
        return self.producer.send(
            'mes-work-reports',
            key=report_data['work_order_id'],
            value={
                'event_type': 'WORK_REPORT',
                'timestamp': report_data['timestamp'],
                'data': report_data
            }
        )

    def send_equipment_event(self, equipment_id, event_type, event_data):
        """发送设备事件"""
        return self.producer.send(
            'mes-equipment-events',
            key=equipment_id,
            value={
                'event_type': event_type,
                'timestamp': event_data['timestamp'],
                'data': event_data
            }
        )
```

```python
# MES Kafka消费者
class MesKafkaConsumer:
    def __init__(self, bootstrap_servers, group_id='mes-consumer-group'):
        self.consumer = KafkaConsumer(
            bootstrap_servers=bootstrap_servers,
            group_id=group_id,
            value_deserializer=lambda v: json.loads(v.decode('utf-8')),
            auto_offset_reset='earliest',
            enable_auto_commit=True
        )

    def consume_work_reports(self):
        """消费报工事件"""
        self.consumer.subscribe(['mes-work-reports'])

        for message in self.consumer:
            event = message.value
            if event['event_type'] == 'WORK_REPORT':
                self.process_work_report(event['data'])

    def process_work_report(self, data):
        # 更新实时看板
        update_dashboard(data)
        # 触发后续流程
        trigger_downstream(data)
