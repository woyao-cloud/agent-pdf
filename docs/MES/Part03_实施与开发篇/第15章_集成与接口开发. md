## 15.3 工业协议

### 15.3.1 OPC UA协议详解

OPC UA（Open Platform Communications Unified Architecture）是工业4.0的核心协议：

```python
# Python OPC UA客户端
from opcua import Client, Node
import time

class OPCUAClient:
    def __init__(self, url):
        self.url = url
        self.client = Client(url)
        self.connected = False

    def connect(self):
        """连接OPC UA服务器"""
        try:
            self.client.connect()
            self.connected = True
            print(f"Connected to OPC UA server: {self.url}")
        except Exception as e:
            print(f"Connection failed: {e}")

    def read_node(self, node_id):
        """读取节点值"""
        if not self.connected:
            return None
        node = self.client.get_node(node_id)
        return node.get_value()

    def write_node(self, node_id, value):
        """写入节点值"""
        if not self.connected:
            return False
        node = self.client.get_node(node_id)
        node.set_value(value)
        return True

    def subscribe_nodes(self, node_ids, callback):
        """订阅节点变化"""
        if not self.connected:
            return

        # 创建订阅
        subscription = self.client.create_subscription(100, callback)

        # 订阅节点
        for node_id in node_ids:
            node = self.client.get_node(node_id)
            subscription.subscribe_data_change(node)

# 使用示例
def on_data_change(node, value):
    print(f"Node {node.nodeid} value changed to: {value}")

client = OPCUAClient("opc.tcp://192.168.1.100:4840")
client.connect()

# 读取设备状态
status = client.read_node("ns=2;i=1001")
print(f"Equipment status: {status}")

# 读取工艺参数
temperature = client.read_node("ns=2;i=1002")
print(f"Temperature: {temperature}")

client.disconnect()
```

### 15.3.2 MQTT协议应用

MQTT是物联网场景的主流协议，适合MES设备接入：

```python
# MQTT在MES设备接入中的应用
import paho.mqtt.client as mqtt
import json

class MesMQTTSubscriber:
    def __init__(self, broker_url, client_id):
        self.client = mqtt.Client(client_id)
        self.client.on_connect = self.on_connect
        self.client.on_message = self.on_message
        self.broker_url = broker_url
        self.message_handlers = {}

    def on_connect(self, client, userdata, flags, rc):
        """连接回调"""
        if rc == 0:
            print(f"Connected to MQTT broker: {self.broker_url}")
            # 订阅设备数据主题
            client.subscribe("mes/+/equipment/#")
            client.subscribe("mes/+/sensor/#")
        else:
            print(f"Connection failed with code {rc}")

    def on_message(self, client, userdata, msg):
        """消息处理"""
        topic = msg.topic
        payload = json.loads(msg.payload)

        # 解析主题获取设备信息
        parts = topic.split('/')
        if len(parts) >= 3:
            workshop = parts[1]
            data_type = parts[2]

            handler = self.message_handlers.get(data_type)
            if handler:
                handler(workshop, payload)

    def register_handler(self, data_type, handler):
        """注册消息处理器"""
        self.message_handlers[data_type] = handler

    def start(self):
        """启动订阅"""
        self.client.connect(self.broker_url, 1883, 60)
        self.client.loop_forever()

# 使用示例
def handle_equipment_data(workshop, data):
    equipment_id = data.get('equipment_id')
    status = data.get('status')
    print(f"Workshop {workshop}, Equipment {equipment_id}: {status}")

subscriber = MesMQTTSubscriber("mqtt://192.168.1.100:1883", "mes-subscriber-01")
subscriber.register_handler("equipment", handle_equipment_data)
subscriber.start()
```

### 15.3.3 协议转换

MES系统常需要整合多种协议的设备：

```python
class ProtocolConverter:
    """协议转换器"""

    def __init__(self):
        self.converters = {
            'modbus_to_opcua': self.modbus_to_opcua,
            'opcua_to_mqtt': self.opcua_to_mqtt,
            'modbus_to_mqtt': self.modbus_to_mqtt
        }

    def modbus_to_opcua(self, modbus_data):
        """Modbus数据转换为OPC UA格式"""
        return {
            'ns': 2,
            'nodeid': f"i={modbus_data['register_address']}",
            'value': modbus_data['value'],
            'datatype': 'Double'
        }

    def opcua_to_mqtt(self, opcua_node, value):
        """OPC UA数据转换为MQTT消息"""
        return {
            'topic': f"mes/equipment/{opcua_node['equipment_id']}/data",
            'payload': {
                'node': opcua_node['node_id'],
                'value': value,
                'timestamp': datetime.utcnow().isoformat()
            }
        }
