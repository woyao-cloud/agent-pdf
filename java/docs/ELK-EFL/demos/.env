# ============================================
# ELK/EFK 演示项目环境变量
# ============================================

# ES 配置
ES_VERSION=8.12.0
ES_HEAP_SIZE=1g
ES_CLUSTER_NAME=elk-demo-cluster

# Kibana 配置
KIBANA_VERSION=8.12.0

# Kafka 配置
KAFKA_VERSION=7.6.0

# Logstash 配置
LOGSTASH_VERSION=8.12.0
LS_HEAP_SIZE=512m

# Filebeat 配置
FILEBEAT_VERSION=8.12.0

# Fluent Bit 配置
FLUENT_BIT_VERSION=2.2

# 应用配置
APP_PORT_ORDER=8081
APP_PORT_PAYMENT=8082
APP_PORT_STOCK=8083