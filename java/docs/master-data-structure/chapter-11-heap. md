```## 11.2 手写实现
```java
public class MinHeap<E> {
    private Object[] heap;
    private int size;
    private final Comparator<E> comparator;

    public MinHeap(int capacity, Comparator<E> comparator) {
        this.heap = new Object[capacity];
        this.comparator = comparator;
    }

    // 插入 - 上浮
    public void offer(E e) {
        heap[size] = e;
        siftUp(size);
        size++;
    }

    // 删除最小 - 下沉
    @SuppressWarnings("unchecked")
    public E poll() {
        E result = (E) heap[0];
        heap[0] = heap[--size];
        heap[size] = null;
        siftDown(0);
        return result;
    }

    @SuppressWarnings("unchecked")
    private void siftUp(int i) {
        while (i > 0) {
            int parent = (i - 1) / 2;
            if (comparator.compare((E) heap[i], (E) heap[parent]) < 0) {
                swap(i, parent);
                i = parent;
            } else break;
        }
    }

    @SuppressWarnings("unchecked")
    private void siftDown(int i) {
        while (2 * i + 1 < size) {
            int smallest = 2 * i + 1;
            int right = smallest + 1;
            if (right < size && comparator.compare((E) heap[right], (E) heap[smallest]) < 0) {
                smallest = right;
            }
            if (comparator.compare((E) heap[smallest], (E) heap[i]) < 0) {
                swap(smallest, i);
                i = smallest;
            } else break;
        }
    }

    private void swap(int i, int j) {
        Object temp = heap[i];
        heap[i] = heap[j];
        heap[j] = temp;
    }
}
```
## 11.3 JDK源码：PriorityQueue
```java
// PriorityQueue（基于最小堆）
public class PriorityQueue<E> extends AbstractQueue<E> implements Serializable {
    private static final int DEFAULT_INITIAL_CAPACITY = 11;
    transient Object[] queue;
    private final Comparator<? super E> comparator;

    public boolean offer(E e) {
        if (e == null) throw new NullPointerException();
        modCount++;
        int i = size;
        if (i >= queue.length) grow(i + 1);
        size = i + 1;
        if (i == 0) queue[0] = e;
        else siftUp(i, e);
        return true;
    }

    // 上浮
    private void siftUp(int k, E x) {
        if (comparator != null) {
            siftUpUsingComparator(k, x);
        } else {
            siftUpComparable(k, x);
        }
    }

    @SuppressWarnings("unchecked")
    private void siftUpUsingComparator(int k, E x) {
        while (k > 0) {
            int parent = (k - 1) >>> 1;
            Object e = queue[parent];
            if (comparator.compare(x, (E) e) >= 0) break;
            queue[k] = e;
            k = parent;
        }
        queue[k] = x;
    }

    // 下沉
    private void siftDown(int k, E x) {
        if (comparator != null) {
            siftDownUsingComparator(k, x);
        } else {
            siftDownComparable(k, x);
        }
    }

    @SuppressWarnings("unchecked")
    private void siftDownUsingComparator(int k, E x) {
        int half = size >>> 1;
        while (k < half) {
            int child = (k << 1) + 1;
            Object c = queue[child];
            int right = child + 1;
            if (right < size && comparator.compare((E) c, (E) queue[right]) > 0) {
                c = queue[child = right];
            }
            if (comparator.compare(x, (E) c) <= 0) break;
            queue[k] = c;
            k = child;
        }
        queue[k] = x;
    }
}
