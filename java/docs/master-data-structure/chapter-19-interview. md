class LRUCache {    private int capacity;    private Map<Integer, Integer> cache;    private LinkedHashMap<Integer, Integer> accessOrder;    public LRUCache(int capacity) {        this.capacity = capacity;        this.cache = new LinkedHashMap<>(capacity, 0.75f, true) {            @Override protected boolean removeEldestEntry(Map.Entry eldest) {                return size() > LRUCache.this.capacity;            }        };    }    public int get(int key) { return cache.getOrDefault(key, -1); }    public void put(int key, int value) { cache.put(key, value); }}```### 迷你Twitter```java
