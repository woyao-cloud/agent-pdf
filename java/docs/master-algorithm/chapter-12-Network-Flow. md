## 12.3 二分图匹配
```java
class BipartiteMatching {
    public int maxMatching(List<Integer>[] g, int nLeft, int nRight) {
        int[] match = new int[nRight];
        Arrays.fill(match, -1);
        int result = 0;
        for (int u = 0; u < nLeft; u++) {
            boolean[] seen = new boolean[nRight];
            if (bpm(g, u, seen, match)) result++;
        }
        return result;
    }
    private boolean bpm(List<Integer>[] g, int u, boolean[] seen, int[] match) {
        for (int v : g[u]) {
            if (!seen[v]) {
                seen[v] = true;
                if (match[v] == -1 || bpm(g, match[v], seen, match)) {
                    match[v] = u;
                    return true;
                }
            }
        }
        return false;
    }
}
```

