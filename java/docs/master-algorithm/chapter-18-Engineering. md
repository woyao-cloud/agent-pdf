// 倒排索引（简化）class InvertedIndex {    Map<String, List<Integer>> index = new HashMap<>();    public void addDocument(int docId, String content) {        String[] words = content.split("\\s+");        for (int i = 0; i < words.length; i++) {            index.computeIfAbsent(words[i], k -> new ArrayList<>()).add(docId);        }    }    public List<Integer> search(String query) {        return index.getOrDefault(query, new ArrayList<>());    }}// PageRank（简化）class PageRank {    public double[] compute(double[][] adj, int iterations) {        int n = adj.length;        double[] rank = new double[n];        Arrays.fill(rank, 1.0 / n);        double[] newRank = new double[n];        for (int it = 0; it < iterations; it++) {            for (int i = 0; i < n; i++) {                newRank[i] = 0;                for (int j = 0; j < n; j++) {                    if (adj[j][i] > 0) {                        int out = 0;                        for (int k = 0; k < n; k++) if (adj[j][k] > 0) out++;                        newRank[i] += rank[j] / out;                    }                }            }            rank = newRank.clone();        }        return rank;    }}```## 18.2 推荐系统算法
