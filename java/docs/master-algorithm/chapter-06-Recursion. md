### 尾递归优化
```java// 传统递归（需要保存调用栈）public int sumRecursive(int n, int acc) {    if (n == 0) return acc;    return sumRecursive(n - 1, acc + n);  // 尾递归}// 尾递归优化 - 编译器可能优化成迭代public int sumTailRecursive(int n, int acc) {    if (n == 0) return acc;    return sumTailRecursive(n - 1, acc + n);  // 尾递归形式}// Java不会自动优化尾递归，需要手动改为迭代
public int sumIterative(int n) {    int acc = 0;    while (n > 0) {        acc += n;        n--;    }    return acc;}```### 记忆化搜索（备忘录）```java// 斐波那契 - 记忆化搜索（自顶向下DP）public class FibonacciMemo {    private Map<Integer, Long> memo = new HashMap<>();    public long fib(int n) {        if (n <= 1) return n;        if (memo.containsKey(n)) return memo.get(n);        long result = fib(n - 1) + fib(n - 2);        memo.put(n, result);        return result;    }    // 时间复杂度: O(n)    // 空间复杂度: O(n)}```### 自底向上DP vs 自顶向下记忆化
```java// 方式1：自顶向下 + 记忆化（递归）public int topDown(int n, int[] memo) {    if (memo[n] != 0) return memo[n];    if (n <= 1) return n;    memo[n] = topDown(n - 1, memo) + topDown(n - 2, memo);    return memo[n];}// 方式2：自底向上（迭代）public int bottomUp(int n) {    if (n <= 1) return n;    int[] dp = new int[n + 1];    dp[0] = 0; dp[1] = 1;    for (int i = 2; i <= n; i++) {        dp[i] = dp[i - 1] + dp[i - 2];    }    return dp[n];}// 方式3：空间优化public int optimized(int n) {    if (n <= 1) return n;    int prev2 = 0, prev1 = 1;    for (int i = 2; i <= n; i++) {        int curr = prev1 + prev2;        prev2 = prev1;        prev1 = curr;    }    return prev1;}```## 6.4 经典递归问题
### 问题1：斐波那契数列```java// 多种实现对比public class FibonacciAll {    // 1. 暴力递归 - O(2^n)    public int fib1(int n) {        if (n <= 1) return n;        return fib1(n - 1) + fib1(n - 2);    }    // 2. 记忆化搜索 - O(n)    public int fib2(int n) {        int[] memo = new int[n + 1];        return helper(n, memo);    }    private int helper(int n, int[] memo) {        if (n <= 1) return n;        if (memo[n] != 0) return memo[n];        memo[n] = helper(n - 1, memo) + helper(n - 2, memo);        return memo[n];    }    // 3. 动态规划 - O(n)    public int fib3(int n) {        if (n <= 1) return n;        int[] dp = new int[n + 1];        dp[0] = 0; dp[1] = 1;        for (int i = 2; i <= n; i++) {            dp[i] = dp[i - 1] + dp[i - 2];        }        return dp[n];    }    // 4. 空间优化 - O(n)时间O(1)空间    public int fib4(int n) {        if (n <= 1) return n;        int prev2 = 0, prev1 = 1;        for (int i = 2; i <= n; i++) {            int temp = prev1 + prev2;            prev2 = prev1;            prev1 = temp;        }        return prev1;    }    // 5. 矩阵快速幂 - O(log n)    public int fib5(int n) {        if (n <= 1) return n;        int[][] a = {{1, 1}, {1, 0}};        int[][] result = matrixPower(a, n - 1);        return result[0][0];    }    private int[][] matrixPower(int[][] a, int n) {        int[][] result = {{1, 0}, {0, 1}};        while (n > 0) {            if ((n & 1) == 1) result = multiply(result, a);            a = multiply(a, a);            n >>= 1;        }        return result;    }    private int[][] multiply(int[][] a, int[][] b) {        int[][] c = {{0, 0}, {0, 0}};        for (int i = 0; i < 2; i++) {            for (int j = 0; j < 2; j++) {                for (int k = 0; k < 2; k++) {                    c[i][j] += a[i][k] * b[k][j];                }            }        }        return c;    }}```### 问题2：汉诺塔
```java
public class Hanoi {    // 经典汉诺塔    public void hanoi(int n, char from, char to, char aux) {        if (n == 1) {            System.out.println("Move disk 1 from " + from + " to " + to);            return;        }        hanoi(n - 1, from, aux, to);        System.out.println("Move disk " + n + " from " + from + " to " + to);        hanoi(n - 1, aux, to, from);    }    // 时间复杂度: O(2^n)    // 移动次数: 2^n - 1    // 递归深度: n    // 双色汉诺塔（限制移动方向）    public void hanoi2(int n, boolean[] plates) {        if (n == 0) return;        hanoi2(n - 1, plates);        if (plates[n - 1]) {            plates[n - 1] = false;            System.out.println("Move " + n + ": A -> B");        } else {            plates[n - 1] = true;            System.out.println("Move " + n + ": B -> A");        }        hanoi2(n - 1, plates);    }}```### 问题3：阶乘相关
```java// 求n! 的所有数字public class FactorialDigits {    // 阶乘数字个数（n<100000可用）    public int countDigits(int n) {        if (n < 0) return 0;        double sum = 0;        for (int i = 2; i <= n; i++) {            sum += Math.log10(i);        }        return (int) sum + 1;    }    // 阶乘尾部零的个数    public int trailingZeros(int n) {        int count = 0;        for (int i = 5; i <= n; i *= 5) {            count += n / i;        }        return count;  // 只取决于因子5的个数    }}```### 问题4：递归树遍历
```java// 二叉树递归遍历public class TreeTraversal {    // 前序遍历：根-左-右    public void preorder(TreeNode root) {        if (root == null) return;        System.out.print(root.val + " ");        preorder(root.left);        preorder(root.right);    }    // 中序遍历：左-根-右    public void inorder(TreeNode root) {        if (root == null) return;        inorder(root.left);        System.out.print(root.val + " ");        inorder(root.right);    }    // 后序遍历：左-右-根    public void postorder(TreeNode root) {        if (root == null) return;        postorder(root.left);        postorder(root.right);        System.out.print(root.val + " ");    }    // 层序遍历（需要队列配合）    public void levelorder(TreeNode root) {        if (root == null) return;        Queue<TreeNode> queue = new LinkedList<>();        queue.offer(root);        while (!queue.isEmpty()) {            TreeNode node = queue.poll();            System.out.print(node.val + " ");            if (node.left != null) queue.offer(node.left);            if (node.right != null) queue.offer(node.right);        }    }    static class TreeNode { int val; TreeNode left, right; TreeNode(int v) { val = v; } }}```## 6.5 递归常见问题与解决
### 栈溢出问题
```java// 问题：递归深度过大会导致StackOverflowError// 解决：1. 改为迭代；2. 增加栈大小；3. 使用尾递归（编译器优化）// 方法1：递归改迭代public int fibIterative(int n) {    if (n <= 1) return n;    int prev2 = 0, prev1 = 1;    for (int i = 2; i <= n; i++) {        int curr = prev1 + prev2;        prev2 = prev1;        prev1 = curr;    }    return prev1;}// 方法2：手动模拟递归栈（适合深度递归）public int fibWithStack(int n) {    if (n <= 1) return n;    class Frame { int n, result, state; }    Stack<Frame> stack = new Stack<>();    stack.push(new Frame());    stack.peek().state = 0;    while (!stack.empty()) {        Frame f = stack.peek();        if (f.n <= 1) {            f.result = f.n;            stack.pop();            if (!stack.empty()) {                Frame parent = stack.peek();                if (parent.state == 0) {                    parent.result = parent.n <= 1 ? parent.n : (parent.n == 2 ? 1 : 0);                } else {                    parent.result += f.result;                }            }        } else if (f.state == 0) {            f.state = 1;            stack.push(new Frame());            stack.peek().n = f.n - 1;        } else {            f.result = f.n <= 1 ? f.n : 1;            f.result += f.result;            stack.pop();            if (!stack.empty()) {                Frame parent = stack.peek();                if (parent.state == 0) {                    parent.result = parent.n <= 1 ? parent.n : 1;                } else {                    parent.result += f.result;                }            }        }    }    return n;}```### 重复计算问题
```java// 问题：斐波那契递归有大量重复计算// 解决：记忆化搜索public class MemoExample {    // 优化前：fib(5)需要计算fib(4)和fib(3)，    // fib(4)需要计算fib(3)和fib(2)...    // 存在大量重复计算！    //    // 优化后：使用memo数组记录已计算结果    public int fibMemo(int n, int[] memo) {        if (n <= 1) return n;        if (memo[n] != 0) return memo[n];  // 已计算        memo[n] = fibMemo(n - 1, memo) + fibMemo(n - 2, memo);        return memo[n];    }}```## 6.6 本章小结- 递归是算法的基础，掌握递归三要素：终止条件、递归调用、缩小规模- 递归vs迭代：迭代效率高但代码复杂，递归简洁但有栈溢出风险- 递归优化：记忆化搜索（自顶向下DP）、尾递归优化- 经典递归问题：斐波那契、阶乘、汉诺塔、树遍历- 实际工程中，优先考虑迭代实现或记忆化搜索