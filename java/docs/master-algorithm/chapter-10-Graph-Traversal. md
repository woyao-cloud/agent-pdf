# 第10章 图算法 - 遍历与基础
## 10.1 图的表示方法
```java
// 邻接表 - 适合稀疏图
class GraphAdjList {    Map<Integer, List<Integer>> adj = new HashMap<>();    public void addEdge(int u, int v) {        adj.computeIfAbsent(u, k -> new ArrayList<>()).add(v);        adj.computeIfAbsent(v, k -> new ArrayList<>()).add(u); // 无向图    }}// 邻接矩阵 - 适合稠密图
class GraphAdjMatrix {    int[][] matrix; int n;    public GraphAdjMatrix(int n) { this.n = n; matrix = new int[n][n]; }    public void addEdge(int u, int v) { matrix[u][v] = matrix[v][u] = 1; }    public void addEdgeWeighted(int u, int v, int w) { matrix[u][v] = matrix[v][u] = w; }}```## 10.2 深度优先搜索（DFS）
```java
// 递归DFSclass DFS {    boolean[] visited;    public void dfs(GraphAdjList graph, int start) {        visited = new boolean[graph.adj.size()];        dfsRecurse(graph, start);    }    private void dfsRecurse(GraphAdjList graph, int v) {        visited[v] = true; System.out.print(v + " ");        for (int neighbor : graph.adj.getOrDefault(v, new ArrayList<>())) {            if (!visited[neighbor]) dfsRecurse(graph, neighbor);        }    }    // 非递归DFS（使用栈）    public void dfsIterative(GraphAdjList graph, int start) {        boolean[] visited = new boolean[graph.adj.size()];        Stack<Integer> stack = new Stack<>();        stack.push(start);        while (!stack.isEmpty()) {            int v = stack.pop();            if (visited[v]) continue;            visited[v] = true; System.out.print(v + " ");            for (int neighbor : graph.adj.getOrDefault(v, new ArrayList<>())) {                if (!visited[neighbor]) stack.push(neighbor);            }        }    }}```## 10.3 广度优先搜索（BFS）```java
class BFS {    public void bfs(GraphAdjList graph, int start) {        boolean[] visited = new boolean[graph.adj.size()];        Queue<Integer> queue = new LinkedList<>();        visited[start] = true; queue.offer(start);        while (!queue.isEmpty()) {            int v = queue.poll();            System.out.print(v + " ");            for (int neighbor : graph.adj.getOrDefault(v, new ArrayList<>())) {                if (!visited[neighbor]) { visited[neighbor] = true; queue.offer(neighbor); }            }        }    }    // 最短路径（BFS）    public int shortestPath(GraphAdjList graph, int start, int target) {        if (start == target) return 0;        boolean[] visited = new boolean[graph.adj.size()];        Queue<Integer> queue = new LinkedList<>();        queue.offer(start); visited[start] = true;        int steps = 0;        while (!queue.isEmpty()) {            steps++;            for (int i = queue.size(); i > 0; i--) {                int v = queue.poll();                for (int neighbor : graph.adj.getOrDefault(v, new ArrayList<>())) {                    if (neighbor == target) return steps;                    if (!visited[neighbor]) { visited[neighbor] = true; queue.offer(neighbor); }                }            }        }        return -1;    }}```## 10.4 连通分量与割点```java
// 连通分量 - 基于DFSclass ConnectedComponents {    public int countComponents(GraphAdjList graph) {        boolean[] visited = new boolean[graph.adj.size()];        int count = 0;        for (int i = 0; i < graph.adj.size(); i++) {            if (!visited[i]) {                dfs(graph, i, visited);                count++;            }        }        return count;    }    private void dfs(GraphAdjList graph, int v, boolean[] visited) {        visited[v] = true;        for (int neighbor : graph.adj.getOrDefault(v, new ArrayList<>())) {            if (!visited[neighbor]) dfs(graph, neighbor, visited);        }    }}// 割点（Tarjan算法）class ArticulationPoints {    int[] disc, low; boolean[] visited, isAP; int time = 0;    public List<Integer> findAP(GraphAdjList graph) {        int n = graph.adj.size();        disc = new int[n]; low = new int[n]; visited = new boolean[n]; isAP = new boolean[n];        dfs(graph, 0, -1);        List<Integer> result = new ArrayList<>();        for (int i = 0; i < n; i++) if (isAP[i]) result.add(i);        return result;    }    private void dfs(GraphAdjList graph, int u, int parent) {        visited[u] = true; disc[u] = low[u] = ++time; int children = 0;        for (int v : graph.adj.getOrDefault(u, new ArrayList<>())) {            if (!visited[v]) {                children++;                dfs(graph, v, u);                low[u] = Math.min(low[u], low[v]);                if (parent != -1 && low[v] >= disc[u]) isAP[u] = true;                if (parent == -1 && children > 1) isAP[u] = true;            } else if (v != parent) {                low[u] = Math.min(low[u], disc[v]);            }        }    }}```## 10.5 拓扑排序```java
class TopologicalSort {    // Kahn算法 - BFS    public List<Integer> topologicalSortKahn(GraphAdjList graph) {        int n = graph.adj.size();        int[] inDegree = new int[n];        for (int u : graph.adj.keySet()) {            for (int v : graph.adj.getOrDefault(u, new ArrayList<>())) inDegree[v]++;        }        Queue<Integer> q = new LinkedList<>();        for (int i = 0; i < n; i++) if (inDegree[i] == 0) q.offer(i);        List<Integer> result = new ArrayList<>();        while (!q.isEmpty()) {            int u = q.poll(); result.add(u);            for (int v : graph.adj.getOrDefault(u, new ArrayList<>())) {                if (--inDegree[v] == 0) q.offer(v);            }        }        return result.size() == n ? result : null; // 有环    }    // DFS方法    public List<Integer> topologicalSortDFS(GraphAdjList graph) {        boolean[] visited = new boolean[graph.adj.size()];        Stack<Integer> stack = new Stack<>();        for (int i = 0; i < graph.adj.size(); i++) {            if (!visited[i]) dfs(graph, i, visited, stack);        }        List<Integer> result = new ArrayList<>();        while (!stack.isEmpty()) result.add(stack.pop());        return result;    }    private void dfs(GraphAdjList graph, int u, boolean[] visited, Stack<Integer> stack) {        visited[u] = true;        for (int v : graph.adj.getOrDefault(u, new ArrayList<>())) {            if (!visited[v]) dfs(graph, v, visited, stack);        }        stack.push(u);    }}```## 10.6 本章小结- 图的表示：邻接表（稀疏）、邻接矩阵（稠密）- DFS适合路径搜索、连通分量，BFS适合最短路径- 拓扑排序：Kahn算法（BFS）和DFS方法- 割点：Tarjan算法