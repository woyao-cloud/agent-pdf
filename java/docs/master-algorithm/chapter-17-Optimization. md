// 1. 状态压缩（一维DP替代二维）int knapsack1D(int[] w, int[] v, int C) {    int[] dp = new int[C + 1];    for (int i = 0; i < w.length; i++) {        for (int c = C; c >= w[i]; c--) {            dp[c] = Math.max(dp[c], dp[c - w[i]] + v[i]);        }    }    return dp[C];}// 2. 复用输入数组（原地算法）public void sortInPlace(int[] arr) {    // 不创建新数组}// 3. 离散化压缩大数值坐标// 将大范围坐标映射到小数组下标```## 17.3 并行算法基础```java
// Fork/Join框架并行计算import java.util.concurrent.ForkJoinPool;import java.util.concurrent.RecursiveTask;class SumTask extends RecursiveTask<Long> {    private final long[] arr; private final int start, end;    private static final int THRESHOLD = 10000;    SumTask(long[] arr, int start, int end) { this.arr = arr; this.start = start; this.end = end; }    @Override protected Long compute() {        if (end - start <= THRESHOLD) {            long sum = 0;            for (int i = start; i < end; i++) sum += arr[i];            return sum;        }        int mid = (start + end) / 2;        SumTask left = new SumTask(arr, start, mid);        SumTask right = new SumTask(arr, mid, end);        left.fork(); return right.compute() + left.join();    }}// 使用Stream并行化Arrays.stream(arr).parallel().sum();```## 17.4 缓存优化策略
```java
// 多级缓存示例class MultiLevelCache<K, V> {    private Map<K, V> l1 = new ConcurrentHashMap<>();    private LoadingCache<K, V> l2;  // Guava    public V get(K key) {        V v = l1.get(key);        if (v == null) {            synchronized (this) {                v = l1.get(key);                if (v == null) {                    v = l2.get(key);                    l1.put(key, v);                }            }        }        return v;    }}```## 17.5 本章小结- 时间优化：预计算、递推、剪枝、合理数据结构- 空间优化：状态压缩、原址操作、离散化- 并行化：Fork/Join、Stream- 缓存：多级缓存策略