// 1. 预计算+缓存
class PrecomputeCache {    // 空间换时间    private Map<Integer, Integer> cache = new HashMap<>();    public int fib(int n) {        if (cache.containsKey(n)) return cache.get(n);        int result;        if (n <= 1) result = n;        else result = fib(n - 1) + fib(n - 2);        cache.put(n, result);        return result;    }}// 2. 递推替代递归（避免重复计算）int fibBottomUp(int n) {    if (n <= 1) return n;    int a = 0, b = 1;    for (int i = 2; i <= n; i++) {        int c = a + b; a = b; b = c; }    return b;}// 3. 剪枝减少搜索空间public void backtrackWithPruning(参数) {    if (不满足上界/约束) return;  // 剪枝    if (满足结束条件) { 结果.add(路径); return; }    for (选择 in 选择列表) {        做选择;        backtrackWithPruning(参数);        撤销选择;    }}// 4. 合理使用数据结构List<Integer> list = new ArrayList<>();  // 随机访问O(1)Map<Integer, Integer> map = new HashMap<>();  // 查找O(1)Set<Integer> set = new HashSet<>();  // 去重O(1)```## 17.2 空间优化技巧
