# 第7章 动态规划
## 7.1 动态规划基本思想
### 解决的问题
动态规划（DP）通过将问题分解为相互重叠的子问题，记录子问题的解避免重复计算，适用于具有"最优子结构"和"重叠子问题"的问题。
### 核心概念
| 概念 | 说明 |
|------|------|
| 最优子结构 | 问题的最优解包含子问题的最优解 |
| 重叠子问题 | 子问题会被多次求解 |
| 状态转移方程 | 描述问题与子问题关系的方程 |
## 7.2 状态定义与转移方程
### 经典问题：斐波那契数列
```java
public class FibonacciDP {
    // 方法1：自顶向下 + 记忆化
    public int fibMemo(int n) {
        int[] memo = new int[n + 1];
        return fib(n, memo);
    }
    private int fib(int n, int[] memo) {
        if (n <= 1) return n;
        if (memo[n] != 0) return memo[n];
        memo[n] = fib(n - 1, memo) + fib(n - 2, memo);
        return memo[n];
    }

    // 方法2：自底向上（最常用）
    public int fibBottomUp(int n) {
        if (n <= 1) return n;
        int[] dp = new int[n + 1];
        dp[0] = 0; dp[1] = 1;
        for (int i = 2; i <= n; i++) {
            dp[i] = dp[i - 1] + dp[i - 2];
        }
        return dp[n];
    }

    // 方法3：空间优化
    public int fibOptimized(int n) {
        if (n <= 1) return n;
        int prev2 = 0, prev1 = 1;
        for (int i = 2; i <= n; i++) {
            int curr = prev1 + prev2;
            prev2 = prev1; prev1 = curr;
        }
        return prev1;
    }
}
```
## 7.3 经典DP问题
### 0-1背包问题
```java
public class Knapsack {
    // 二维dp数组
    public int knapsack(int[] weights, int[] values, int capacity) {
        int n = weights.length;
        int[][] dp = new int[n + 1][capacity + 1];
        for (int i = 1; i <= n; i++) {
            for (int w = 0; w <= capacity; w++) {
                if (weights[i - 1] <= w) {
                    dp[i][w] = Math.max(
                        dp[i - 1][w],
                        dp[i - 1][w - weights[i - 1]] + values[i - 1]
                    );
                } else {
                    dp[i][w] = dp[i - 1][w];
                }
            }
        }
        return dp[n][capacity];
    }

    // 空间优化（一维）
    public int knapsackOptimized(int[] weights, int[] values, int capacity) {
        int[] dp = new int[capacity + 1];
        for (int i = 0; i < weights.length; i++) {
            for (int w = capacity; w >= weights[i]; w--) {
                dp[w] = Math.max(dp[w], dp[w - weights[i]] + values[i]);
            }
        }
        return dp[capacity];
    }
}
```
### 最长公共子序列（LCS）
```java
public class LCS {
    public int longestCommonSubsequence(String s1, String s2) {
        int m = s1.length(), n = s2.length();
        int[][] dp = new int[m + 1][n + 1];
        for (int i = 1; i <= m; i++) {
            for (int j = 1; j <= n; j++) {
                if (s1.charAt(i - 1) == s2.charAt(j - 1)) {
                    dp[i][j] = dp[i - 1][j - 1] + 1;
                } else {
                    dp[i][j] = Math.max(dp[i - 1][j], dp[i][j - 1]);
                }
            }
        }
        return dp[m][n];
    }

    // 打印LCS
    public String printLCS(String s1, String s2) {
        int m = s1.length(), n = s2.length();
        int[][] dp = new int[m + 1][n + 1];
        for (int i = 1; i <= m; i++) {
            for (int j = 1; j <= n; j++) {
                if (s1.charAt(i - 1) == s2.charAt(j - 1)) {
                    dp[i][j] = dp[i - 1][j - 1] + 1;
                } else {
                    dp[i][j] = Math.max(dp[i - 1][j], dp[i][j - 1]);
                }
            }
        }
        StringBuilder sb = new StringBuilder();
        int i = m, j = n;
        while (i > 0 && j > 0) {
            if (s1.charAt(i - 1) == s2.charAt(j - 1)) {
                sb.append(s1.charAt(i - 1));
                i--; j--;
            } else if (dp[i - 1][j] > dp[i][j - 1]) {
                i--;
            } else {
                j--;
            }
        }
        return sb.reverse().toString();
    }
}
```
### 最长递增子序列（LIS）
```java
public class LIS {
    // O(n^2)方法
    public int lengthOfLIS(int[] nums) {
        int n = nums.length;
        int[] dp = new int[n];
        Arrays.fill(dp, 1);
        int max = 1;
        for (int i = 1; i < n; i++) {
            for (int j = 0; j < i; j++) {
                if (nums[i] > nums[j]) {
                    dp[i] = Math.max(dp[i], dp[j] + 1);
                }
            }
            max = Math.max(max, dp[i]);
        }
        return max;
    }

    // O(n log n)方法（二分+dp）
    public int lengthOfLISOptimized(int[] nums) {
        int[] dp = new int[nums.length];
        int len = 0;
        for (int num : nums) {
            int i = Arrays.binarySearch(dp, 0, len, num);
            if (i < 0) i = -(i + 1);
            dp[i] = num;
            if (i == len) len++;
        }
        return len;
    }
}
```
## 7.4 状态压缩与空间优化
```java
// 状态压缩：二维→一维
public class StateCompression {
    // 完全背包（每种物品无限件）
    public int completeKnapsack(int[] weights, int[] values, int capacity) {
        int[] dp = new int[capacity + 1];
        for (int i = 0; i < weights.length; i++) {
            for (int w = weights[i]; w <= capacity; w++) {  // 正序
                dp[w] = Math.max(dp[w], dp[w - weights[i]] + values[i]);
            }
        }
        return dp[capacity];
    }

    // 多重背包（每种物品有数量限制）
    public int multipleKnapsack(int[] weights, int[] values, int[] counts, int capacity) {
        int[] dp = new int[capacity + 1];
        for (int i = 0; i < weights.length; i++) {
            int num = counts[i];
            // 二进制拆分优化
            int k = 1;
            while (k < num) {
                for (int w = capacity; w >= k * weights[i]; w--) {
                    dp[w] = Math.max(dp[w], dp[w - k * weights[i]] + k * values[i]);
                }
                num -= k;
                k *= 2;
            }
            for (int w = capacity; w >= num * weights[i]; w--) {
                dp[w] = Math.max(dp[w], dp[w - num * weights[i]] + num * values[i]);
            }
        }
        return dp[capacity];
    }
}
```
## 7.5 树形DP与区间DP
### 树形DP
```java
// 打家劫舍 III（树形DP）
public class HouseRobberIII {
    public int rob(TreeNode root) {
        int[] result = dfs(root);
        return Math.max(result[0], result[1]);  // [不偷, 偷]
    }

    private int[] dfs(TreeNode node) {
        if (node == null) return new int[2];
        int[] left = dfs(node.left);
        int[] right = dfs(node.right);
        int[] dp = new int[2];
        dp[0] = Math.max(left[0], left[1]) + Math.max(right[0], right[1]);  // 不偷当前
        dp[1] = left[0] + right[0] + node.val;  // 偷当前
        return dp;
    }
}
```
### 区间DP
```java
// 矩阵链乘
public class MatrixChainMultiply {
    public int matrixChainMultiply(int[] dims) {
        int n = dims.length - 1;
        int[][] dp = new int[n + 1][n + 1];
        for (int len = 2; len <= n; len++) {
            for (int i = 1; i <= n - len + 1; i++) {
                int j = i + len - 1;
                dp[i][j] = Integer.MAX_VALUE;
                for (int k = i; k < j; k++) {
                    dp[i][j] = Math.min(dp[i][j],
                        dp[i][k] + dp[k + 1][j] + dims[i - 1] * dims[k] * dims[j]);
                }
            }
        }
        return dp[1][n];
    }
}
```
## 7.6 本章小结
- 动态规划核心：最优子结构 + 重叠子问题
- 实现方式：自顶向下（记忆化）、自底向上
- 空间优化：状态压缩、降维
- 常见类型：线性DP、区间DP、树形DP、背包问题