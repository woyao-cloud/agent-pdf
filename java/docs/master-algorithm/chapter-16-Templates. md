// 位1的个数public int hammingWeight(int n) {    int count = 0;    while (n != 0) {        n &= (n - 1);        count++;    }    return count;}// 判断是否为2的幂public boolean isPowerOfTwo(int n) {    return n > 0 && (n & (n - 1)) == 0;}// 交换两数（不借助临时变量）public void swap(int[] arr, int i, int j) {    arr[i] ^= arr[j];    arr[j] ^= arr[i];    arr[i] ^= arr[j];}// 找出缺失的数字public int missingNumber(int[] nums) {    int res = 0;    for (int i = 0; i < nums.length; i++) res ^= (i + 1) ^ nums[i];    return res;}```## 16.4 常用解题模板
