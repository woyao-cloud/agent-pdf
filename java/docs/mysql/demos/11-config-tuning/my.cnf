[mysqld]
# ============================================================
# InnoDB 核心配置
# ============================================================

# InnoDB缓冲池大小（最重要的参数，建议设为物理内存的50%-70%）
innodb_buffer_pool_size = 256M

# InnoDB日志文件大小（越大，写入性能越好，但恢复时间越长）
innodb_log_file_size = 128M

# 日志刷新策略（1=每次提交刷盘，2=每秒刷盘，0=不刷盘）
innodb_flush_log_at_trx_commit = 2

# 双写缓冲（防止页损坏，SSD可以关闭）
innodb_doublewrite = ON

# ============================================================
# 连接配置
# ============================================================

# 最大连接数
max_connections = 200

# 线程缓存（减少线程创建开销）
thread_cache_size = 16

# 连接队列长度
back_log = 100

# ============================================================
# 查询缓存（MySQL 8.0已移除，此处仅作参考）
# ============================================================

# ============================================================
# 排序与JOIN缓冲区
# ============================================================

# 排序缓冲区（每个需要排序的会话分配）
sort_buffer_size = 256K

# JOIN缓冲区（每个需要JOIN的会话分配）
join_buffer_size = 256K

# 临时表大小（超过此值使用磁盘临时表）
tmp_table_size = 64M
max_heap_table_size = 64M

# ============================================================
# 慢查询日志
# ============================================================

slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 0.5
log_queries_not_using_indexes = 1

# ============================================================
# 其他优化
# ============================================================

# 表打开缓存
table_open_cache = 2000

# 文件句柄缓存
open_files_limit = 65535
