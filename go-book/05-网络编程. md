# 第 5 章 网络编程
> **本章导读**：Go 的网络编程能力非常强大，标准库内置了完整的 TCP/UDP/HTTP/gRPC 支持。本章覆盖常见网络编程场景。
## 1. TCP/UDP
### 1.1 TCP Server
```go
func main() {    // 监听    listener, err := net.Listen("tcp", "localhost:8080")    if err != nil {        log.Fatal(err)    }    defer listener.Close()        for {        conn, err := listener.Accept()        if err != nil {            log.Println(err)            continue        }        go handleConn(conn)    }}func handleConn(conn net.Conn) {    defer conn.Close()    buf := make([]byte, 1024)    for {        n, err := conn.Read(buf)        if err != nil {            if err != io.EOF {                log.Println(err)            }            break        }        conn.Write(buf[:n])  // echo    }}```### 1.2 TCP Client
```go
func main() {    conn, err := net.Dial("tcp", "localhost:8080")    if err != nil {        log.Fatal(err)    }    defer conn.Close()        conn.Write([]byte("Hello Server"))    buf := make([]byte, 1024)    n, _ := conn.Read(buf)    fmt. Println(string(buf[:n]))}```### 1.3 UDP
```go
// UDP Serverfunc main() {    addr, _ := net.ResolveUDPAddr("udp", ":8080")    conn, _ := net.ListenUDP("udp", addr)    defer conn.Close()        buf := make([]byte, 1024)    for {        n, clientAddr, _ := conn.ReadFromUDP(buf)        conn.WriteToUDP(buf[:n], clientAddr)    }}```## 2. HTTP
### 2.1 HTTP Server
```go
func main() {    http.HandleFunc("/hello", helloHandler)    http.HandleFunc("/json", jsonHandler)    log.Fatal(http.ListenAndServe(":8080", nil))}func helloHandler(w http.ResponseWriter, r *http.Request) {    fmt.Fprintf(w, "Hello, %s!", r.URL.Query().Get("name"))}func jsonHandler(w http.ResponseWriter, r *http.Request) {    w.Header().Set("Content-Type", "application/json")    json.NewEncoder(w).Encode(map[string]string{        "message": "Hello World",    })}```### 2.2 HTTP Client
```go
func main() {    // GET    resp, err := http.Get("https://api.example.com/data")    if err != nil {        log.Fatal(err)    }    defer resp.Body.Close()        body, _ := io. ReadAll(resp.Body)    fmt.Println(string(body))        // POST    resp2, _ := http.Post(        "https://api.example.com/data",        "application/json",        bytes. NewBuffer([]byte(`{"name":"test"}`)),    )    defer resp2.Body.Close()}```### 2.3 自定义 HTTP Client
```go
func main() {    client := &http.Client{        Timeout: 30 * time.Second,        Transport: &http.Transport{            MaxIdleConns:        100,            IdleConnTimeout:   90 * time.Second,            TLSClientConfig:   &tls.Config{InsecureSkipVerify: true},        },    }        resp, _ := client.Get("https://example.com")    defer resp.Body.Close()}```### 2.4 HTTP Router
```go
import "github. com/gorilla/mux"func main() {    r := mux.NewRouter()    r.HandleFunc("/api/users/{id}", getUser).Methods("GET")    r.HandleFunc("/api/users", createUser).Methods("POST")    http.Handle("/", r)    http.ListenAndServe(":8080", nil)}func getUser(w http.ResponseWriter, r *http.Request) {    vars := mux.Vars(r)    id := vars["id"]    fmt.Fprintf(w, "User: %s", id)}```## 3. gRPC
### 3.1 定义 proto
```protobuf
syntax = "proto3";package example;service Greeter {  rpc SayHello (HelloRequest) returns (HelloReply) {}  rpc StreamHello (stream HelloRequest) returns (stream HelloReply) {}}message HelloRequest {  string name = 1;}message HelloReply {  string message = 1;}}```### 3.2 生成代码
```bash
go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.31.0
go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.3.0
protoc --go_out=. --go-grpc_out=. proto/greeter.proto```### 3.3 gRPC Server
```go
type server struct {    pb.UnimplementedGreeterServer}func (s *server) SayHello(ctx context. Context, req *pb.HelloRequest) (*pb.HelloReply, error) {    return &pb.HelloReply{        Message: "Hello " + req.Name,    }, nil}func main() {    lis, _ := net.Listen("tcp", ":50051")    s := grpc.NewServer()    pb.RegisterGreeterServer(s, &server{})    s.Serve(lis)}```### 3.4 gRPC Client
```go
func main() {    conn, _ := grpc.Dial("localhost:50051", grpc.WithInsecure())    defer conn.Close()        c := pb.NewGreeterClient(conn)    resp, _ := c.SayHello(context.Background(), &pb.HelloRequest{Name: "World"})    fmt.Println(resp.Message)}```## 4. WebSocket
### 4.1 Server
```go
import "github.com/gorilla/websocket"var upgrader = websocket. Upgrader{    ReadBufferSize:  1024,    WriteBufferSize: 1024,}func handler(w http.ResponseWriter, r *http.Request) {    conn, err := upgrader.Upgrade(w, r, nil)    if err != nil {        return    }    defer conn.Close()        for {        messageType, p, err := conn.ReadMessage()        if err != nil {            break        }        if err := conn.WriteMessage(messageType, p); err != nil {            break        }    }}func main() {    http.HandleFunc("/ws", handler)    http.ListenAndServe(":8080", nil)}```## 5. 小结
